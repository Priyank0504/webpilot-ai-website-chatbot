# --- Mode: defaults run fully offline (no API keys) ---
LLM_PROVIDER=mock            # mock | openai | azure   (mock = extractive stand-in, NOT a real LLM)
EMBEDDING_PROVIDER=local     # local | openai | azure  (local = deterministic hashing embedder)
EMBEDDING_DIM=384            # MUST match the model (e.g. 1536 for text-embedding-3-small)

# --- Azure AI Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_CHAT_DEPLOYMENT=
AZURE_EMBEDDING_DEPLOYMENT=

# --- OpenAI-compatible ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Safety / limits ---
ALLOW_LOCAL_URLS=false       # true ONLY for local demo (lets the crawler reach localhost). Never in production.
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_DELAY=0.2
RATE_LIMIT_PER_MIN=30
DB_PATH=webpilot.db
